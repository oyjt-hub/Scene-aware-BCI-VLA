    }
  ],
  "x-protocol": {
    "version": "V4-02-contract-1",
    "scope": "actual LIBERO images/privileged scene state plus simulated BCI; development only",
    "prototype_defaults_not_empirically_optimal": true,
    "limits": {
      "objects": 16,
      "recent_events_total": 8,
      "diagnostic_receipts": 64,
      "prefix_tokens": 8
    },
    "tensor_contract": {
      "roi": [
        "B",
        16,
        "D_roi"
      ],
      "semantic": [
        "B",
        16,
        "D_sem"
      ],
      "boxes": [
        "B",
        16,
        4
      ],
      "candidate_mask": [
        "B",
        16
      ],
      "roi_mask": [
        "B",
        16
      ],
      "semantic_mask": [
        "B",
        16
      ],
      "task_history": [
        "B",
        8,
        "D_task"
      ],
      "diagnostic_history": [
        "B",
        8,
        "D_diag"
      ],
      "combined_real_history_count_max": 8,
      "history_valid_masks": [
        "B",
        8
      ],
      "prefix": [
        "B",
        8,
        "D_vlm"
      ],
      "D_vlm_verified": false,
      "padding_rule": "explicit PAD or EMPTY_INPUT plus mask, never an outside/ambiguous label",
      "fixture_dimensions": {
        "D_roi": 4,
        "D_sem": 3,
        "D_vlm": 6
      }
    },
    "model_feature_allowlist": [
      "scene features/boxes/aliases and masks",
      "valid role-separated past events",
      "valid public session state",
      "deidentified diagnostic summary"
    ],
    "model_input_excludes": [
      "sample_id",
      "split",
      "private_labels",
      "hidden_truth",
      "future answers",
      "injected schedules",
      "raw PROBE object semantics in channel branch",
      "raw channel query tokens at VLM"
    ],
    "score_kinds": {
      "RAW_SCORE": "finite raw values, never renamed probabilities",
      "CALIBRATED_PROBABILITY": "normalized probabilities plus role/layout/mapping-scoped fixture calibration",
      "HARD_LABEL": "single declared selection, not probability calibration",
      "NONE": "no decoded observation"
    },
    "event_effects": {
      "TASK": "candidate evidence only",
      "INTENT_QUERY": "clarify task candidates, cannot authorize",
      "PROBE": "diagnostic summary only, never replace confirmed task",
      "CONFIRM": "noisy observed accept of exact task; separate existing authorization still required",
      "REJECT": "reject bound pending suggestion, pause, no automatic old-task resume",
      "NO_RESPONSE": "retain original question role; no task update; eligible timed-out PROBE is diagnostic nonresponse",
      "CANCEL": "clear pending/confirmed task and request queue/cache invalidation",
      "STOP": "existing direct stop path and latch, independent of neural/VLM"
    },
    "diagnostic_estimand": "Next known-target attempt succeeds under the same mapping/layout/covered conditions and time window; eligible timed-out no-response counts unsuccessful, not a task choice",
    "diagnostic_policy": {
      "window_s": 30,
      "ttl_s": 15,
      "min_attempts": 3,
      "min_covered_symbols": 2,
      "overflow": "mark truncated and insufficient; never selectively retain by hidden target"
    },
    "state_invalidation": {
      "mapping_change": "drop pending question/suggestion/confirmation and diagnostic applicability; pause/reconfirm, keep old records as invalid audit only",
      "scene_instance_or_binding_change": "invalidate affected task/aliases/authorization, clear queue/cache before new confirmation",
      "probe": "no confirmed-task mutation",
      "cancel_or_stop": "clear task and pending state; STOP stays latched",
      "completed_task": "clear current task, retain public audit"
    },
    "task_grammar_status": "pick/place are syntactic development fixtures; backend capability remains false pending V4-03",
    "legacy_boundary": {
      "schema_compatible_with_v2_event": false,
      "role_mapping": {
        "TASK": "TASK_QUERY",
        "INTENT_QUERY": "TASK_QUERY with distinct question provenance",
        "PROBE": "CHANNEL_PROBE",
        "CONFIRM": "CONFIRM"
      },
      "adapter_implementation_step": "V4-11",
      "authority": "existing V2 authorization/STOP must remain independent"
    },
    "validator_scope": "stdlib reference checks the generated schema subset plus cross-field invariants; not a general-purpose JSON Schema implementation; does not prove feature independence or real calibration",
    "frozen_parent": "configs/v4/interfaces.json remains unchanged; same semantic validators"
  }
