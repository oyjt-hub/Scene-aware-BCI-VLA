{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bci-vla:libero-development-data:4.1",
  "title": "V4-02 synthetic public/private/output interface contract",
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scene_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scene_revision": {
          "type": "integer",
          "minimum": 1
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mapping_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "session_id",
        "scene_id",
        "scene_revision",
        "mapping_id",
        "mapping_revision"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "suggestion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "action": {
          "enum": [
            "pick",
            "place"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "destination_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "valid_until_s": {
          "type": "number",
          "minimum": 0
        },
        "capability_verified": {
          "const": false
        }
      },
      "required": [
        "task_id",
        "task_revision",
        "suggestion_id",
        "context",
        "action",
        "source_id",
        "destination_id",
        "valid_until_s",
        "capability_verified"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "OBJECT",
            "TASK",
            "DIAGNOSTIC",
            "DECISION"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "option_id",
        "symbol",
        "kind",
        "reference"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "enum": [
            "TASK",
            "INTENT_QUERY",
            "PROBE",
            "CONFIRM"
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "layout_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issued_at_s": {
          "type": "number",
          "minimum": 0
        },
        "expires_at_s": {
          "type": "number",
          "minimum": 0
        },
        "presentation_ack": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "diagnostic_option_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "proposal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/task"
            }
          ]
        }
      },
      "required": [
        "question_id",
        "role",
        "context",
        "layout_id",
        "issued_at_s",
        "expires_at_s",
        "presentation_ack",
        "options",
        "diagnostic_option_id",
        "proposal"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance": {
          "enum": [
            "synthetic_fixture"
          ]
        },
        "fit_split": {
          "const": "calibration-fit"
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mapping_revision": {
          "type": "integer",
          "minimum": 1
        },
        "layout_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "TASK",
              "INTENT_QUERY",
              "PROBE",
              "CONFIRM"
            ]
          },
          "minItems": 1,
          "maxItems": 4
        },
        "valid_until_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "artifact_id",
        "provenance",
        "fit_split",
        "mapping_id",
        "mapping_revision",
        "layout_id",
        "roles",
        "valid_until_s"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "score_kind": {
          "enum": [
            "RAW_SCORE",
            "CALIBRATED_PROBABILITY",
            "HARD_LABEL",
            "NONE"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "option_id",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "selected_option_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "calibration": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/calibration"
            }
          ]
        }
      },
      "required": [
        "score_kind",
        "values",
        "selected_option_id",
        "calibration"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "TASK",
            "INTENT_QUERY",
            "PROBE",
            "CONFIRM",
            "REJECT",
            "NO_RESPONSE",
            "CANCEL",
            "STOP"
          ]
        },
        "original_role": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "TASK",
                "INTENT_QUERY",
                "PROBE",
                "CONFIRM"
              ]
            }
          ]
        },
        "question": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/question"
            }
          ]
        },
        "started_at_s": {
          "type": "number",
          "minimum": 0
        },
        "ended_at_s": {
          "type": "number",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "EXPIRED",
                "STALE_CONTEXT",
                "PRESENTATION_UNACKNOWLEDGED"
              ]
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidence"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "sequence",
        "role",
        "original_role",
        "question",
        "started_at_s",
        "ended_at_s",
        "valid",
        "invalid_reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "alias": {
          "type": "string",
          "pattern": "^OBJ_([0-9]|1[0-5])$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "bbox_xyxy": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "object_valid": {
          "type": "boolean"
        },
        "roi_feature": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 8192
            }
          ]
        },
        "roi_valid": {
          "type": "boolean"
        },
        "semantic_feature": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 8192
            }
          ]
        },
        "semantic_valid": {
          "type": "boolean"
        }
      },
      "required": [
        "instance_id",
        "alias",
        "label",
        "bbox_xyxy",
        "object_valid",
        "roi_feature",
        "roi_valid",
        "semantic_feature",
        "semantic_valid"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "layout_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "window_s": {
          "const": 30
        },
        "ttl_s": {
          "const": 15
        },
        "min_attempts": {
          "const": 3
        },
        "min_covered_symbols": {
          "const": 2
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "correct_count": {
          "type": "integer",
          "minimum": 0
        },
        "no_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 16
        },
        "latest_ended_at_s": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "status": {
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT",
            "EXPIRED"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "context",
        "layout_id",
        "window_s",
        "ttl_s",
        "min_attempts",
        "min_covered_symbols",
        "receipts",
        "attempt_count",
        "correct_count",
        "no_response_count",
        "covered_symbols",
        "latest_ended_at_s",
        "status",
        "truncated"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "confirmed_task": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "task": {
                  "$ref": "#/$defs/task"
                },
                "confirmation_receipt": {
                  "$ref": "#/$defs/event"
                }
              },
              "required": [
                "task",
                "confirmation_receipt"
              ],
              "additionalProperties": false
            }
          ]
        },
        "pending_suggestion": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/task"
            }
          ]
        },
        "pending_question": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/question"
            }
          ]
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        },
        "stop_latched": {
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false
        }
      },
      "required": [
        "confirmed_task",
        "pending_suggestion",
        "pending_question",
        "diagnostics",
        "stop_latched",
        "execution_authorized"
      ],
      "additionalProperties": false
    },
    "public_input": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "PUBLIC_INPUT"
        },
        "schema_version": {
          "const": "bci-vla-interaction/4.1"
        },
        "sample_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "as_of_s": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "type": "object",
          "properties": {
            "bci": {
              "const": "simulated_channel"
            },
            "vision": {
              "enum": [
                "annotated_fixture",
                "privileged_simulator",
                "detector_recording"
              ]
            },
            "feature_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "real_eeg": {
              "const": false
            },
            "physical_robot": {
              "const": false
            }
          },
          "required": [
            "bci",
            "vision",
            "feature_profile_id",
            "real_eeg",
            "physical_robot"
          ],
          "additionalProperties": false
        },
        "scene": {
          "type": "object",
          "properties": {
            "observed_at_s": {
              "type": "number",
              "minimum": 0
            },
            "image_ref": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              ]
            },
            "image_valid": {
              "type": "boolean"
            },
            "roi_dim": {
              "type": "integer",
              "minimum": 1
            },
            "semantic_dim": {
              "type": "integer",
              "minimum": 1
            },
            "objects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/object"
              },
              "minItems": 0,
              "maxItems": 16
            },
            "truncation": {
              "type": "object",
              "properties": {
                "original_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "retained_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "policy": {
                  "enum": [
                    "none",
                    "public_detector_order"
                  ]
                },
                "target_recall_known": {
                  "const": false
                }
              },
              "required": [
                "original_count",
                "retained_count",
                "policy",
                "target_recall_known"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "observed_at_s",
            "image_ref",
            "image_valid",
            "roi_dim",
            "semantic_dim",
            "objects",
            "truncation"
          ],
          "additionalProperties": false
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "current_event_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "selection_event_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "task_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "public_state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "record_type",
        "schema_version",
        "sample_id",
        "context",
        "as_of_s",
        "provenance",
        "scene",
        "history",
        "current_event_id",
        "selection_event_id",
        "task_options",
        "public_state"
      ],
      "additionalProperties": false
    },
    "private_labels": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "PRIVATE_LABELS"
        },
        "schema_version": {
          "const": "bci-vla-interaction/4.1"
        },
        "sample_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "public_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "calibration_fit",
            "calibration_audit"
          ]
        },
        "hidden_truth": {
          "type": "object",
          "properties": {
            "goal": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/task"
                }
              ]
            },
            "channel_injected_mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "changed_at_s": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          },
          "required": [
            "goal",
            "channel_injected_mode",
            "changed_at_s"
          ],
          "additionalProperties": false
        },
        "identifiability": {
          "type": "object",
          "properties": {
            "intent": {
              "enum": [
                "IDENTIFIED",
                "AMBIGUOUS",
                "UNOBSERVABLE"
              ]
            },
            "channel": {
              "enum": [
                "SUPPORTED",
                "INSUFFICIENT"
              ]
            }
          },
          "required": [
            "intent",
            "channel"
          ],
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "properties": {
            "intent": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "POINT",
                    "SET",
                    "NONE"
                  ]
                },
                "candidate_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 0,
                  "maxItems": 16
                },
                "outside": {
                  "type": "boolean"
                },
                "mask": {
                  "type": "boolean"
                }
              },
              "required": [
                "mode",
                "candidate_ids",
                "outside",
                "mask"
              ],
              "additionalProperties": false
            },
            "main_task": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "TASK",
                    "CLARIFICATION",
                    "NONE"
                  ]
                },
                "task": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/task"
                    }
                  ]
                },
                "text": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  ]
                },
                "mask": {
                  "type": "boolean"
                }
              },
              "required": [
                "mode",
                "task",
                "text",
                "mask"
              ],
              "additionalProperties": false
            },
            "channel": {
              "type": "object",
              "properties": {
                "mask": {
                  "type": "boolean"
                },
                "next_probe_success": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "target_time_s": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ]
                }
              },
              "required": [
                "mask",
                "next_probe_success",
                "target_time_s"
              ],
              "additionalProperties": false
            },
            "interaction": {
              "type": "object",
              "properties": {
                "mask": {
                  "type": "boolean"
                },
                "action": {
                  "enum": [
                    "PROPOSE_TASK",
                    "ASK_INTENT",
                    "CHECK_CHANNEL",
                    "WAIT"
                  ]
                },
                "teacher": {
                  "enum": [
                    "public_rule_v1",
                    "annotator_visible_history"
                  ]
                },
                "teacher_input_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "mask",
                "action",
                "teacher",
                "teacher_input_sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "intent",
            "main_task",
            "channel",
            "interaction"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_type",
        "schema_version",
        "sample_id",
        "variant_id",
        "public_input_sha256",
        "split",
        "hidden_truth",
        "identifiability",
