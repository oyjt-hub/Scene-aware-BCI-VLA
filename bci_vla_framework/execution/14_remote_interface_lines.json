    },
    {
      "line": 345,
      "text": "    right_target = clamp_rad(right_target_raw)"
    },
    {
      "line": 346,
      "text": "    "
    },
    {
      "line": 347,
      "text": "    return left_target, right_target, left_grip_raw, right_grip_raw"
    },
