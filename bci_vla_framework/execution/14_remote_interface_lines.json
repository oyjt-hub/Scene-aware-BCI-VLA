    {
      "line": 305,
      "text": "def get_current_joints_rad(piper: Any) -> np.ndarray:"
    },
    {
      "line": 306,
      "text": "    if piper is None: return np.zeros(6)"
    },
    {
      "line": 307,
      "text": "    try:"
    },
    {
      "line": 308,
      "text": "        js_ret = piper.GetArmJointMsgs()"
    },
    {
      "line": 309,
      "text": "        if isinstance(js_ret, tuple) and len(js_ret) >= 3:"
    },
    {
      "line": 310,
      "text": "            js = js_ret[2]"
    },
    {
      "line": 311,
      "text": "        else:"
    },
    {
      "line": 312,
      "text": "            js = js_ret"
    },
    {
      "line": 313,
      "text": "            "
    },
    {
      "line": 314,
      "text": "        if hasattr(js, \"joint_state\") and js.joint_state:"
    },
    {
      "line": 315,
      "text": "            st = js.joint_state"
    },
    {
      "line": 316,
      "text": "            for names in [[\"joint_1\", \"joint_2\", \"joint_3\", \"joint_4\", \"joint_5\", \"joint_6\"],[\"angle_1\", \"angle_2\", \"angle_3\", \"angle_4\", \"angle_5\", \"angle_6\"]]:"
    },
    {
      "line": 317,
      "text": "                try:"
    },
    {
      "line": 318,
      "text": "                    vals =[getattr(st, n) for n in names]"
    },
    {
      "line": 319,
      "text": "                    return np.deg2rad(np.array(vals, dtype=np.float64) / 1000.0)"
    },
    {
      "line": 320,
      "text": "                except AttributeError: continue"
    },
    {
      "line": 321,
      "text": "        return np.zeros(6)"
    },
    {
      "line": 322,
      "text": "    except Exception as e:"
    },
    {
      "line": 323,
      "text": "        return np.zeros(6)"
    },
    {
      "line": 324,
      "text": ""
    },
    {
      "line": 325,
      "text": "def get_gripper_value(piper):"
    },
    {
      "line": 326,
      "text": "    if piper is None: return 0.0"
    },
    {
      "line": 327,
      "text": "    try:"
    },
    {
      "line": 328,
      "text": "        gripper_msgs = piper.GetArmGripperMsgs()"
    },
    {
      "line": 329,
      "text": "        if hasattr(gripper_msgs, 'gripper_state') and gripper_msgs.gripper_state:"
    },
    {
      "line": 330,
      "text": "            raw_value = gripper_msgs.gripper_state.grippers_angle"
    },
    {
      "line": 331,
      "text": "            width_mm = raw_value / 1000.0"
    },
    {
      "line": 332,
      "text": "            return width_mm"
    },
    {
      "line": 333,
      "text": "    except Exception:"
    },
    {
      "line": 334,
      "text": "        pass"
    },
    {
      "line": 335,
      "text": "    return 0.0"
    },
