{
  "protocol_version": "1.0",
  "status": "planned_not_executed",
  "purpose": "upstream_context_intent_comparison_with_fixed_vla",
  "supported_actions": ["pick", "place", "fold"],
  "data": {
    "primary_evidence": "real_independently_annotated_scenes",
    "synthetic_use": "pipeline_smoke_or_explicitly_labeled_training_augmentation_only",
    "target_real_physical_scenes": 60,
    "target_context_variants_per_scene": 6,
    "split_unit": "physical_scene_or_larger_near_duplicate_recording_group",
    "target_split_scenes": {"train": 32, "validation": 8, "test": 20},
    "two_independent_annotators": true,
    "split_seed": 20261015,
    "test_is_frozen_before_model_selection": true,
    "allow_test_training_or_threshold_tuning": false,
    "public_input_key": "observation",
